{{!-- Dashboard Page --}}

<style>
    .search-panel {
        background: #e9ecef;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        display: flex;
        gap: 15px;
        align-items: center;
        flex-wrap: wrap;
    }

    .search-panel select,
    .search-panel input[type="date"] {
        padding: 8px;
        border-radius: 4px;
        border: 1px solid #ccc;
    }

    button#btn-search {
        padding: 8px 15px;
        background: #007bff;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
    }

    button#btn-search:hover { background: #0056b3; }

    .seat-grid-display {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 15px;
        margin-top: 20px;
    }

    .seat-card {
        border: 1px solid #ddd;
        border-radius: 6px;
        padding: 15px;
        text-align: center;
        transition: all 0.2s;
    }

    .seat-card.available { background-color: #d4edda; border-color: #c3e6cb; color: #155724; }
    .seat-card.reserved  { background-color: #f8d7da; border-color: #f5c6cb; color: #721c24; }

    .seat-number { font-size: 1.2em; font-weight: bold; display: block; margin-bottom: 5px; }
    .reserver-name { font-size: 0.85em; display: block; }
    .reserver-name a { color: #721c24; text-decoration: underline; }
    .refresh-info { font-size: 0.8em; color: #666; margin-top: 10px; text-align: right; }
</style>

<h2>Check Lab Availability</h2>

<div class="search-panel">
    <div>
        <label>Lab:</label>
        <select id="search-lab">
            <option value="LAB1">Gokongwei G301</option>
            <option value="LAB2">Gokongwei G302</option>
            <option value="LAB3">Velasco V201</option>
        </select>
    </div>
    <div>
        <label>Date:</label>
        <input type="date" id="search-date">
    </div>
    <div>
        <label>Time:</label>
        <select id="search-time"></select>
    </div>
    <button id="btn-search">Search</button>
</div>

<div style="margin-bottom: 10px;">
    <span style="display:inline-block; width:15px; height:15px; background:#d4edda; border:1px solid #ccc; vertical-align:middle;"></span> Available
    <span style="display:inline-block; width:15px; height:15px; background:#f8d7da; border:1px solid #ccc; vertical-align:middle; margin-left:15px;"></span> Reserved
</div>

<div id="availability-grid" class="seat-grid-display">
    <p>Select criteria and click Search to view availability.</p>
</div>

<p class="refresh-info">Auto-refreshing every 5 seconds... <span id="last-updated"></span></p>

<script src="/dashboard.js"></script>
