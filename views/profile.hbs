{{!-- User Profile Page --}}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/profile.css">

<div class="profile-container">

    {{!-- Left: Profile Info --}}
    <div class="profile-info">
        <div class="pic">
            <img id="profilepic" src="{{userInfo.profilepic}}" class="profile-img" onerror="this.src='/img/default-avatar.png'">
            <input type="file" id="uploadPic" accept="image/*">
            <label for="uploadPic" class="btn-upload">Change Profile Picture</label>
        </div>

        <div class="info-section">
            <h2 id="name">{{userInfo.name}}</h2>
            <h6>About</h6>
            <hr>

            <div class="about-info">
                <span class="info-title">Course</span>
                <span class="info" id="course">{{userInfo.course}}</span>
            </div>

            <div class="about-info">
                <span class="info-title">Year Level</span>
                <span class="info" id="yearlevel">{{userInfo.yearLevel}}</span>
            </div>

            <div class="about-info">
                <span class="info-title">Bio</span>
                <span class="info bio" id="bio">{{userInfo.bio}}</span>
            </div>

            <div class="manageinfobutton">
                <button type="button" class="btn-manageinfo" data-bs-toggle="modal" data-bs-target="#manageAccountModal">
                    Manage Account
                </button>
            </div>

            <div class="manageinfobutton" style="margin-top: 10px;">
                <a href="/logout" class="btn-manageinfo" style="background-color: #dc3545; display: inline-block; text-decoration: none;">
                    Logout
                </a>
            </div>
        </div>
    </div>

    {{!-- Right: Reservations --}}
    <div class="reservations">
        <h2>Reservations</h2>
        <div class="reservation-cards" id="reservationcards">
            {{#if reservations.length}}
                {{#each reservations}}
                <div class="reservation-card">
                    <p><strong>Date:</strong> {{this.date}}</p>
                    <p><strong>Room:</strong> {{this.room}}</p>
                    <p><strong>Time:</strong> {{join this.timeSlots ", "}}</p>
                    <p><strong>Seats:</strong> {{join this.seats ", "}}</p>
                    <p><strong>Status:</strong> {{this.status}}</p>
                </div>
                {{/each}}
            {{else}}
                <p class="no-reservations">No reservations yet.</p>
            {{/if}}
        </div>
    </div>

</div>

{{!-- Manage Account Modal --}}
<div class="modal fade" id="manageAccountModal" tabindex="-1" aria-labelledby="manageAccountLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content manage-modal-content">

            <div class="modal-header manage-modal-header">
                <h5 class="modal-title" id="manageAccountLabel">Manage Account</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            {{!-- Tabs --}}
            <ul class="nav nav-tabs manage-tabs" id="manageTabs">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-info">Edit Info</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-pic">Profile Picture</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link tab-danger" data-bs-toggle="tab" data-bs-target="#tab-delete">Delete Account</button>
                </li>
            </ul>

            <div class="tab-content manage-modal-body">

                {{!-- Edit Info --}}
                <div class="tab-pane fade show active" id="tab-info">
                    <div class="formbody">
                        <label for="courseInput" class="formlabel">Course</label>
                        <select class="form-select" id="courseInput">
                            <option value="Computer Science">BS Computer Science</option>
                            <option value="Software Engineering">BS Software Engineering</option>
                            <option value="Information Technology">BS Information Technology</option>
                            <option value="Data Science">BS Data Science</option>
                            <option value="Information Systems">BS Information Systems</option>
                        </select>
                    </div>
                    <div class="formbody">
                        <label for="yearlevelInput" class="formlabel">Year Level</label>
                        <select class="form-select" id="yearlevelInput">
                            <option value="1st Year">1st Year</option>
                            <option value="2nd Year">2nd Year</option>
                            <option value="3rd Year">3rd Year</option>
                            <option value="4th Year">4th Year</option>
                        </select>
                    </div>
                    <div class="formbody">
                        <label for="bioInput" class="formlabel">Bio</label>
                        <textarea class="form-control" id="bioInput" rows="4" placeholder="Write your description"></textarea>
                    </div>
                    <div class="manage-footer">
                        <button type="button" class="btn-modalclose" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn-modalsave" id="savechanges">Save Changes</button>
                    </div>
                </div>

                {{!--Profile Picture --}}
                <div class="tab-pane fade" id="tab-pic">
                    <div class="pic-preview-wrap">
                        <img id="previewPic" src="{{userInfo.profilepic}}" class="pic-preview" onerror="this.src='/img/default-avatar.png'">
                    </div>
                    <p class="pic-hint">Click below to choose a new profile picture</p>
                    <input type="file" id="uploadPicModal" accept="image/*">
                    <label for="uploadPicModal" class="btn-upload-modal">Choose Photo</label>
                    <div class="manage-footer">
                        <button type="button" class="btn-modalclose" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn-modalsave" id="savePic">Save Picture</button>
                    </div>
                </div>

                {{! Delete Account --}}
                <div class="tab-pane fade" id="tab-delete">
                    <div class="delete-warning">
                        This action <strong>cannot be undone.</strong> All your data and reservations will be permanently removed.
                    </div>
                    <label class="delete-confirm-label">Type <strong>DELETE</strong> to confirm:</label>
                    <input type="text" id="deleteConfirmInput" class="form-control delete-confirm-input" placeholder="Type DELETE here">
                    <p id="deleteInputError" class="delete-input-error" style="display:none;">Please type DELETE exactly to confirm.</p>
                    <div class="manage-footer">
                        <button type="button" class="btn-modalclose" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn-confirm-delete" id="confirmDeleteBtn" disabled>Delete My Account</button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="/profile.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
